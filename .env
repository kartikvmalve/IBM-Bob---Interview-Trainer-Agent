# ============================================================
#  IBM Interview Trainer Agent — Environment Configuration
#  Problem Statement No. 22
# ============================================================

# ----------------------------------------------------------
# IBM watsonx.ai Credentials (required)
# Get from: https://cloud.ibm.com → watsonx.ai → Manage → API key
# ----------------------------------------------------------
IBM_WATSONX_API_KEY=fQQZtYWznSZEknJ0x4n-QlD2yY-CB_XHBhEXV2IUq_0c
IBM_WATSONX_URL=https://us-south.ml.cloud.ibm.com
IBM_WATSONX_PROJECT_ID=ab1d20c2-cb47-4d8d-994d-323564087cd4

# ----------------------------------------------------------
# IBM Granite Model Configuration (mandatory)
# Available models: ibm/granite-13b-chat-v2, ibm/granite-3-8b-instruct
# ----------------------------------------------------------
IBM_GRANITE_MODEL_ID=ibm/granite-4-h-small
IBM_GRANITE_MAX_TOKENS=1024
IBM_GRANITE_TEMPERATURE=0.7
IBM_GRANITE_TOP_P=0.9
IBM_GRANITE_TOP_K=50

# ----------------------------------------------------------
# IBM Watson Discovery (optional — for web-scale RAG retrieval)
# Get from: https://cloud.ibm.com → Watson Discovery
# ----------------------------------------------------------
IBM_WATSON_DISCOVERY_API_KEY=your_watson_discovery_api_key_here
IBM_WATSON_DISCOVERY_URL=https://api.us-south.discovery.watson.cloud.ibm.com
IBM_WATSON_DISCOVERY_INSTANCE_ID=your_discovery_instance_id_here
IBM_WATSON_DISCOVERY_PROJECT_ID=your_discovery_project_id_here

# ----------------------------------------------------------
# IBM Cloud Object Storage (optional — for resume/document storage)
# ----------------------------------------------------------
IBM_COS_API_KEY=your_cos_api_key_here
IBM_COS_INSTANCE_CRN=your_cos_instance_crn_here
IBM_COS_ENDPOINT=https://s3.us-south.cloud-object-storage.appdomain.cloud
IBM_COS_BUCKET_NAME=interview-trainer-docs

# ----------------------------------------------------------
# Application Settings
# ----------------------------------------------------------
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=false
APP_SECRET_KEY=change_this_to_a_strong_random_secret_key_32chars

# ----------------------------------------------------------
# Vector Store (ChromaDB — local, no cloud account needed)
# ----------------------------------------------------------
CHROMA_DB_PATH=./data/chroma_db
CHROMA_COLLECTION_NAME=interview_knowledge_base

# ----------------------------------------------------------
# RAG Configuration
# ----------------------------------------------------------
RAG_TOP_K_RESULTS=5
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=64
