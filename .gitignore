# ============================================================
#  IBM Interview Trainer Agent — .gitignore
# ============================================================

# --- Credentials (NEVER commit real keys) ---
.env

# --- Python cache ---
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.pyc

# --- Virtual environments ---
venv/
.venv/
env/
ENV/

# --- ChromaDB vector store (large binary, rebuild on deploy) ---
data/chroma_db/

# --- Pytest / coverage ---
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
dist/
build/

# --- IDE / OS ---
.vscode/
.idea/
*.DS_Store
Thumbs.db

# --- Logs ---
*.log
logs/

# --- Temporary files ---
*.tmp
*.bak
